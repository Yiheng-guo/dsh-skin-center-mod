+  it('does not leak one stylesheet link per switch when the server pre-rendered one', async () => {
+    const { controller } = harness()
+    // Exactly what tap-index-adapter renders before the runtime boots: a link
+    // with the very href the controller is about to request, earlier in <head>.
+    const preRendered = document.createElement('link')
+    preRendered.rel = 'stylesheet'
+    preRendered.href = '/api/skin-center/v2/skins/harbor/stylesheet'
+    document.head.appendChild(preRendered)
+
+    await controller.switchTo('harbor', entryFor('harbor'))
+    const own = [...document.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')].find((l) => l !== preRendered)
+    expect(own).toBeDefined()
+
+    await controller.switchTo('matrix', entryFor('matrix'))
+    // The link the runtime created for harbor must be gone. An href lookup
+    // answered with the pre-rendered node instead, removed that one, and leaked
+    // the created one — one leaked link per switch, for the life of the page.
+    expect(own!.isConnected).toBe(false)
+
+    // The invariant is boundedness, not emptiness: the pre-rendered link is not
+    // owned by any activation and legitimately survives, so the head holds the
+    // pre-rendered link plus the current skin's own. Switching repeatedly must
+    // not move that number.
+    for (const id of ['mint', 'harbor', 'matrix', 'harbor']) {
+      await controller.switchTo(id, entryFor(id))
+    }
+    expect(document.head.querySelectorAll('link[rel="stylesheet"]')).toHaveLength(2)
+    expect(document.head.querySelector('link[rel="stylesheet"]')).toBe(preRendered)
+  })
