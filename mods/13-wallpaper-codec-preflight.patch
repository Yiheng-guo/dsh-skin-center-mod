+const VIDEO_MIME_BY_EXTENSION: Record<string, string> = {
+  mp4: 'video/mp4',
+  webm: 'video/webm',
+  mkv: 'video/x-matroska',
+  avi: 'video/x-msvideo',
+  mov: 'video/quicktime',
+}
+
+/**
+ * Lower-case extension of one file-ish string, or '' when it carries none.
+ * Only the last path segment counts, and only a dot that is not that segment's
+ * first character, so a directory named 'Movies.2019' cannot masquerade as one.
+ */
+function extensionOf(value: string): string {
+  const segment = value.slice(value.lastIndexOf('/') + 1)
+  const dot = segment.lastIndexOf('.')
+  return dot > 0 ? segment.slice(dot + 1).toLowerCase() : ''
+}
