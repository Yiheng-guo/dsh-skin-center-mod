+ * container the host serves as video.
+ *
+ * The media routes hand out base64url tokens (the base64url alphabet has no
+ * dot), so the extension of the real file survives only on the id of a library
+ * entry synthesized from a manual folder ('<dir>/<file>.mkv', see
+ * synthesizeMediaEntries in src/we-library.ts). A project id is a directory
+ * name, so it is read only when it is path-shaped; anything else stays unknown,
+ * and unknown never counts as unsupported.
+ */
+function videoMimeOf(videoUrl: string, id: string): string | null {
+  const fromUrl = VIDEO_MIME_BY_EXTENSION[extensionOf(videoUrl)]
+  if (fromUrl !== undefined) return fromUrl
+  if (id.includes('/')) {
+    const fromId = VIDEO_MIME_BY_EXTENSION[extensionOf(id)]
+    if (fromId !== undefined) return fromId
+  }
+  return null
+}
 
